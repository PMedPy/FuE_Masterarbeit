@article{lonchampMycoproteinNovelFunctional2022,
  title = {Mycoprotein as Novel Functional Ingredient: {{Mapping}} of Functionality, Composition and Structure throughout the {{Quorn}} Fermentation Process},
  shorttitle = {Mycoprotein as Novel Functional Ingredient},
  author = {Lonchamp, Julien and Stewart, Kelly and Munialo, Claire D. and Evans, Laurence and Akintoye, Muyiwa and Gordon, Susan and Clegg, Paul S. and Willoughby, Nik and Euston, Stephen R.},
