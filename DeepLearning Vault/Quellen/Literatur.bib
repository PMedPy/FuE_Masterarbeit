@article{chenOptimizationAspergillusNiger2025,
  title = {Optimization of {{Aspergillus Niger}} Fermentation for Enzyme Production and Enzymatic Hydrolysis of Wheat Bran for Total Ferulic Acid via {{RSM}}},
  author = {Chen, Liujun and Zhao, Jing and Li, Pengpeng and Kong, Tianyou and Gao, Jia and Han, Xiangxin and Chen, Shuming and Guo, Xiaomin},
  date = {2025-11-27},
  journaltitle = {Scientific Reports},
  shortjournal = {Sci. Rep.},
  volume = {15},
  number = {1},
  pages = {42407},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-025-26625-6},
  url = {https://www.nature.com/articles/s41598-025-26625-6},
  urldate = {2026-05-27},
  abstract = {Phenolic acids in wheat bran, particularly ferulic acid (FA), exhibit antimicrobial properties, but most FA is bound to cell wall polysaccharides via ester/ether linkages, severely limiting its bioavailability and extraction. Distinct from prior studies relying on commercial enzymes or single-component substrates, this study enhanced FA release through Aspergillus niger (A. niger) fermentation (no exogenous enzymes), utilizing a wheat bran-vinegar residue (9:1, w/w) substrate. Fermentation and destarched wheat bran (DSWB) enzymatic hydrolysis were optimized via Box-Behnken design and response surface methodology (BBD-RSM), yielding high enzyme activities: feruloyl esterase (16.63\,±\,0.32 U/g), xylanase (3098.21\,±\,47.27 U/g), and cellulase (21.12\,±\,0.14 U/g). Hydrolysis released 5.41\,±\,0.03~mg/g total FA (TFA) (including derivatives), which exerted significant antibacterial activity against Escherichia coli and Staphylococcus aureus, with MIC/MBC of 0.6/2.4~mg/mL (E. coli) and 0.3/1.2~mg/mL (S. aureus). This study offers valuable data for wheat bran-derived antimicrobials and enzyme-treated bran as feed antibiotic alternatives.},
  langid = {english},
  keywords = {Applied microbiology,Hydrolases},
  file = {/Users/paulmedebach/Zotero/storage/JFUEXAFG/Chen et al. - 2025 - Optimization of Aspergillus Niger fermentation for enzyme production and enzymatic hydrolysis of whe.pdf}
}

@article{chistiOxygenTransferMixing2002,
