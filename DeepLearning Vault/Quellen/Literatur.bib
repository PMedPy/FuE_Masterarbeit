  author = {Chisti, Yusuf and Jauregui-Haza, Ulises J.},
  date = {2002-03-01},
  journaltitle = {Biochemical Engineering Journal},
  shortjournal = {Biochem. Eng. J.},
  volume = {10},
  number = {2},
  pages = {143--153},
  issn = {1369-703X},
  doi = {10.1016/S1369-703X(01)00174-7},
  url = {https://www.sciencedirect.com/science/article/pii/S1369703X01001747},
  urldate = {2026-05-13},
  abstract = {Gas holdup, mixing, liquid circulation and gas–liquid oxygen transfer were characterized in a large (∼1.5m3) draft-tube airlift bioreactor agitated with Prochem® hydrofoil impellers placed in the draft-tube. Measurements were made in water and in cellulose fiber slurries that resembled broths of mycelial microfungi. Use of mechanical agitation generally enhanced mixing performance and the oxygen transfer capability relative to when mechanical agitation was not used; however, the oxygen transfer efficiency was reduced by mechanical agitation. The overall volumetric gas–liquid mass transfer coefficient declined with the increasing concentration of the cellulose fiber solids; however, the mixing time in these strongly shear thinning slurries was independent of the solids contents (0–4\%w/v). Surface aeration never contributed more than 12\% to the total mass transfer in air–water.},
  keywords = {Aeration,Airlift bioreactors,Bioreactors,Hydrofoil impellers,Mixing,Surface aeration},
  file = {/Users/paulmedebach/Zotero/storage/CLQZR667/Chisti und Jauregui-Haza - 2002 - Oxygen transfer and mixing in mechanically agitated airlift bioreactors.pdf;/Users/paulmedebach/Zotero/storage/RPF32ZQ2/S1369703X01001747.html}
}

