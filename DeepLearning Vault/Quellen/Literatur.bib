@article{kimBioproductionMushroomMycelium2011,
  title = {Bioproduction of Mushroom Mycelium of {{Agaricus}} Bisporus by Commercial Submerged Fermentation for the Production of Meat Analogue},
  author = {Kim, Kyoungju and Choi, Byungsun and Lee, Inhee and Lee, Hyeyoung and Kwon, Soonhyang and Oh, Kyoungyoung and Kim, Augustine Yonghwi},
